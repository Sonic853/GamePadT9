<local:PanelWindow x:Class="GamePadT9.ProgramProfilesForm" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GamePadT9" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GamePad T9 · 程序列表" x:Name="ProgramProfilesWindow" Width="1080" Height="800" MinWidth="860" MinHeight="630">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Title="GamePad T9 · 程序列表"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#171F21" Padding="20,24,20,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="程序列表" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgramCount" Style="{StaticResource Description}" FontSize="12" Margin="0,8,0,18"/>
                        <ui:TextBox x:Name="ProgramSearch" PlaceholderText="搜索程序名称或路径" Icon="{ui:SymbolIcon Search24}" TextChanged="Search" AutomationProperties.Name="搜索程序"/>
                        <TextBlock x:Name="SearchStatus" Style="{StaticResource Description}" FontSize="12" Margin="0,8,0,4"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <ui:Button x:Name="AddExecutable" Content="添加 EXE" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="Browse"/>
                        <ui:Button x:Name="AddRunningProgram" Content="从运行中的程序添加" Icon="{ui:SymbolIcon Window24}" HorizontalAlignment="Stretch" Click="PickRunning"/>
                    </StackPanel>
                    <ListBox x:Name="ProgramList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SideItem}" SelectionChanged="SelectedProgram" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="程序配置列表">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="11" Opacity=".6" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></DockPanel>
                                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity=".65" Margin="0,6,0,0" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,16">
                    <StackPanel>
                        <TextBlock x:Name="ProfileBadge" Foreground="{StaticResource PanelAccent}" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ProfileHeading" Style="{StaticResource PageHeading}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ProfilePath" Style="{StaticResource Description}" Margin="0,0,0,24"/>
                        <ui:Card Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="输入方式" Style="{StaticResource SectionHeading}"/>
                            <ComboBox x:Name="InputModeSelector" MinHeight="40" Margin="0,6,0,12" SelectionChanged="ChangeMode" AutomationProperties.Name="输入方式"/>
                            <TextBlock x:Name="ModeDescription" Style="{StaticResource Description}" FontSize="13"/>
                        </StackPanel></ui:Card>
                        <ui:Card x:Name="CompletionCard" Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="外部输入框 · 完成操作" Style="{StaticResource SectionHeading}"/>
                            <ComboBox x:Name="CompletionSelector" MinHeight="40" Margin="0,6,0,12" AutomationProperties.Name="外部输入框完成操作"/>
                            <StackPanel x:Name="CompletionHint" Orientation="Horizontal"><TextBlock Text="短按选词，长按完成输入。" Style="{StaticResource Description}" VerticalAlignment="Center"/></StackPanel>
                        </StackPanel></ui:Card>
                        <ui:Card Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="配置生效规则" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="独立配置优先；未添加的程序使用全局配置。保存后，下次开启输入时生效。" Style="{StaticResource Description}" FontSize="13"/>
                            <ui:Button x:Name="RemoveProgram" Content="移除独立配置，继承全局" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Margin="0,12,0,0" Click="Remove"/>
                        </StackPanel></ui:Card>
                    </StackPanel>
                </ScrollViewer>
                <ui:InfoBar x:Name="SaveError" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True" Margin="32,0,32,12"/>
                <Border Grid.Row="2" BorderBrush="#354042" BorderThickness="0,1,0,0" Padding="24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="CancelProfiles" Content="取消" MinWidth="88" Margin="0,0,10,0" Click="Cancel" IsCancel="True"/>
                        <ui:Button x:Name="SaveProfiles" Content="保存配置" Style="{StaticResource PrimaryAction}" Click="Save" IsDefault="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</local:PanelWindow>
